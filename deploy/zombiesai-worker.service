# Keep this gaming PC playing for the learner whenever it is free: it finds the learner on the LAN by its beacon,
# starts as many games as the PC can carry, joins the run, steps aside while you play (or while
# ~/.config/zombiesai/pause exists), and waits for the next run when the learner goes away
# (scripts/fleet_worker.py; docs/rl.md, "Several PCs"). A user unit, like zombiesai-live.
#
#   mkdir -p ~/.config/zombiesai
#   printf 'ZOMBIES_FLEET_TOKEN=%s\n' '<token>' > ~/.config/zombiesai/fleet.env   # the learner is found by beacon
#   chmod 600 ~/.config/zombiesai/fleet.env
#   cp deploy/zombiesai-worker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now zombiesai-worker
#   journalctl --user -u zombiesai-worker -f        # "joined run ...", or why the learner refused it

[Unit]
Description=ZombiesAI: play this PC's games for the learner
After=network-online.target

[Service]
EnvironmentFile=%h/.config/zombiesai/fleet.env
WorkingDirectory=%h/Projects/ZombiesAI
ExecStart=/usr/bin/uv run --no-sync python -u scripts/fleet_worker.py --actors auto --yield-to-games
# A refusal (another commit, other settings) exits; trying again every minute picks up a fix once it is made.
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=40

[Install]
WantedBy=default.target
